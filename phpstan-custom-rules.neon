parameters:
    level: 0
    paths:
        - modules/php
    excludePaths:
        - vendor
        - modules/php/PHPStan
    scanFiles:
        - _ide_helper.php
        - tests/stubs/BgaFrameworkStubs.php
        - modules/php/PHPStan/EnforceDbWrapperRule.php
    ignoreErrors:
        - identifier: method.notFound
        - identifier: parameter.requiredAfterOptional
        - identifier: array.duplicateKey

services:
    -
        class: Bga\Games\diceforge\PHPStan\EnforceDbWrapperRule
        tags:
            - phpstan.rules.rule
